          {
            "id": 872796,
            "parent_id": 872795,
            "title": "References to the Rules",
            "description": null,
            "index": "1.1.1",
            "chapter": "1",
            "content": "<p class=\"level1\">These Rules (the <a href=\"term_rules\" class=\"term\"  data-glossary-type=\"global\" data-link-type=\"glossary\" data-content=\"term_rules\">Rules</a>) are called the National Electricity Rules.</p>",
            "content_type": "clause",
            "metadata": null,
            "links": {
              "self": "https://energy-rules.aemc.gov.au/api/v1/rules/803/content/872796",
              "parent": "https://energy-rules.aemc.gov.au/api/v1/rules/803/content/872795"
            },
            "parent": [],
            "children": []
          },
          {
            "id": 872797,
            "parent_id": 872795,
            "title": "Italicised expressions",
            "description": null,
            "index": "1.1.2",
            "chapter": "1",
            "content": "<p class=\"level1\">Italicised expressions in the <a href=\"term_rules\" class=\"term\"  data-glossary-type=\"global\" data-link-type=\"glossary\" data-content=\"term_rules\">Rules</a> are defined in the glossary in <a href=\"#chap_10\" data-link-type=\"chapter\" data-content=\"874880\">Chapter 10</a>.</p>",
            "content_type": "clause",
            "metadata": null,
            "links": {
              "self": "https://energy-rules.aemc.gov.au/api/v1/rules/803/content/872797",
